# ── Telegram Bot (dari BotFather) ─────────────────────────────────────────────
BOT_TOKEN=your_bot_token_here

# ── Admin IDs (pisahkan dengan koma jika lebih dari satu) ─────────────────────
ADMIN_IDS=123456789

# ── Telethon MTProto (dari https://my.telegram.org/apps) ─────────────────────
API_ID=your_api_id_here
API_HASH=your_api_hash_here
PHONE_NUMBER=+628123456789
# String session (generate dengan: python generate_session.py)
STRING_SESSION=

# ── Paths (opsional) ──────────────────────────────────────────────────────────
DATABASE_PATH=data/broadcast.db
SESSION_DIR=sessions
LOG_DIR=logs

# ── Broadcast ─────────────────────────────────────────────────────────────────
# Jeda antar pesan dalam detik (minimal 1.0, disarankan 3.0)
BROADCAST_DELAY=3.0

# Test mode: true = tidak benar-benar mengirim pesan
TEST_MODE=false
